rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helper Functions (Safe with no crash if user doc is missing)
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(uid) { 
      return isSignedIn() && request.auth.uid == uid; 
    }
    
    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }
    
    function getUserRole() {
      return getUserData().get('role', 'consumer');
    }
    
    function isAdmin() { 
      return isSignedIn() && getUserRole() == 'admin'; 
    }
    
    function isManufacturer() {
      return isSignedIn() && getUserRole() == 'manufacturer';
    }
    
    function isManufacturerOwner(data) {
      return isSignedIn() && (
        (request.auth.uid == data.manufacturerId && isManufacturer()) || isAdmin()
      );
    }
    
    function isConsumer() {
      return isSignedIn();
    }

    // 1. Users Collection
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Regular users cannot grant themselves admin or manufacturer roles on creation
      allow create: if isAdmin() || (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role == 'consumer'));
      // Regular users cannot elevate their own role on update
      allow update: if isAdmin() || (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }
    
    // 2. Personal Medications (Mobile User Medicine Tracker)
    match /userMedications/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // 3. Prescriptions (Uploaded Prescriptions)
    match /prescriptions/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && (!('isConfirmedByUser' in request.resource.data) || request.resource.data.isConfirmedByUser == true);
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && (!('isConfirmedByUser' in request.resource.data) || request.resource.data.isConfirmedByUser == true);
    }

    // 4. Medicine Reminders
    match /reminders/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // 5. Emergency Profiles
    match /emergencyProfiles/{uid} {
      allow write: if isSignedIn() && request.auth.uid == uid;
      // Single-document read only: a shared profile can be fetched by someone who knows
      // the uid (e.g. via the QR code), but profiles can NOT be enumerated/listed.
      allow get: if (isSignedIn() && request.auth.uid == uid) || resource.data.isSharingEnabled == true;
      allow list: if isSignedIn() && request.auth.uid == uid;
    }

    // 6. Verification Records (Consumer Scan History)
    match /verificationRecords/{docId} {
      // Users may only create history records attributed to themselves.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 7. Scan Events & Activity (Anomalies & Analytics)
    match /scanEvents/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }
    
    match /scanActivity/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 8. Catalog: Medicines (Approved Reference Database)
    match /medicines/{docId} {
      allow read: if true; // Public catalog for consumer lookups & verification
      allow create: if isManufacturerOwner(request.resource.data) || isAdmin();
      allow update: if isManufacturerOwner(resource.data) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 9. Batches
    match /batches/{docId} {
      allow read: if true; // Needed by consumers to verify batch status
      allow create: if isManufacturerOwner(request.resource.data) || isAdmin();
      allow update: if isManufacturerOwner(resource.data) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 10. Packaging References
    match /packagingReferences/{docId} {
      allow read: if true;
      allow create: if isManufacturerOwner(request.resource.data) || isAdmin();
      allow update: if isManufacturerOwner(resource.data) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 11. Verification Data
    match /verificationData/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // 12. Suspicious Reports
    match /suspiciousReports/{docId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    
    // 13. Safety Alerts
    match /alerts/{docId} {
      allow read: if true; // Public safety alerts
      allow create, update, delete: if isAdmin(); // no client currently publishes alerts; manufacturers must not forge recalls
    }
    
    // 14. Analytics
    match /analytics/{docId} {
      allow read: if isManufacturer() || isAdmin();
      allow write: if isAdmin();
    }

    // 15. Anomalies
    match /anomalies/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
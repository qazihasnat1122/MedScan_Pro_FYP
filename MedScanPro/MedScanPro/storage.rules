rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Prescriptions bucket: private to the owner
    match /prescriptions/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Suspicious reports bucket: uploadable by authenticated users, readable by owner and admins
    match /reports/{userId}/{allPaths=**} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Packaging and medicine images: readable publicly, uploadable by authenticated users
    match /packaging/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /medicines/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all: deny all unmapped paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
